---
import { Image } from 'astro:assets';
import { Navbar } from '@/components/ui/navbar';
import CtaBand from '@/components/ui/cta-band.astro';
import Footer from '@/components/ui/footer.astro';
import MainLayout from '@/layouts/main.astro';
import Resources from '@/components/home/resources.astro';
import Section from '@/components/ui/section.astro';
import accelLogo from '@/assets/about/accel.webp';
import heroLogos from '@/assets/about/hero-logos.svg';
import teamData from '@/data/team.json';

/**
 * Team grid (Webflow `.c_team--cms_list`): `src/data/team.json` is the
 * Webflow "Teams" collection; drafts are not shown on the live site.
 */
const headshots = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/team/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const team = teamData
  .filter((member) => !member.draft)
  .sort((a, b) => a.order - b.order)
  .map((member) => {
    const image = headshots[member.headshot];
    if (!image) throw new Error(`Headshot ${member.headshot} not found`);
    return { ...member, image: image.default };
  });
/** Webflow `.social_icn` LinkedIn glyph (14x14). */
const linkedinIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M3.17852 14V4.55374H0.177409V14H3.17852ZM1.67795 3.26401C2.7245 3.26401 3.37589 2.53864 3.37589 1.63214C3.35639 0.705241 2.7245 4.89563e-07 1.69781 4.89563e-07C0.671215 4.89563e-07 0 0.705241 0 1.63214C0 2.53864 0.65125 3.26401 1.65839 3.26401H1.67795Z" fill="currentColor"/><path fill-rule="evenodd" clip-rule="evenodd" d="M4.83936 14H7.84044V8.72481C7.84044 8.44249 7.85994 8.16045 7.93919 7.95863C8.15614 7.39455 8.64995 6.81034 9.47901 6.81034C10.565 6.81034 10.9994 7.67659 10.9994 8.94647V14H14.0002V8.58365C14.0002 5.68218 12.5196 4.33208 10.5451 4.33208C8.92613 4.33208 8.21537 5.27883 7.82048 5.92369H7.84052V4.55374H4.83944C4.87882 5.44011 4.83936 14 4.83936 14Z" fill="currentColor"/></svg>`;
---

<MainLayout
  title="About Shorebird | Built by the Creators of Flutter"
  description="Learn about Shorebird, the team behind Code Push and Shorebird CI. Founded by Flutter's creator, we're building the platform Flutter teams deserve."
>
  <Navbar client:load initialTheme="dark" />

  {/* Hero (Webflow `header.g_page--section` + `.c_hero--about--logos`). */}
  <Section as="header" theme="dark" id="hero">
    <div class="pb-[calc(var(--spacer-section-hero)-var(--nav-height))]"></div>
    <div class="grid grid-cols-12 gap-x-column-gap gap-y-row-gap">
      <div class="hidden lg:col-span-2 lg:block"></div>
      <div
        class="col-span-12 flex flex-col items-center text-center lg:col-span-8"
      >
        <img
          src={heroLogos.src}
          width={heroLogos.width}
          height={heroLogos.height}
          alt="Shorebird and Flutter logos"
          class="h-auto w-full max-w-[360px]"
        />
        <h1 class="title-xxl pb-text-m">Ship Flutter apps at the speed of web</h1>
      </div>
    </div>
    <div class="pb-section-s"></div>
  </Section>

  {/* "Founded in 2023" (light). */}
  <Section theme="light" id="founded">
    <div class="grid grid-cols-12 gap-x-column-gap gap-y-row-gap">
      <div class="hidden lg:col-span-2 lg:block"></div>
      <div
        class="col-span-12 flex flex-col items-center text-center lg:col-span-8"
      >
        <h2 class="title-m pb-text-l">
          Founded in 2023 by Eric Seidel, creator of Flutter.
        </h2>
        <p class="body-m">
          We care about making portable development the default and creating a
          rich and robust Flutter ecosystem. Our flagship service, Code Push,
          enables instant app updates without app store delays.
        </p>
      </div>
    </div>
  </Section>

  {/* Mission card (Webflow `.c_mission_card`: dark card on the light band). */}
  <Section theme="light" container="large" id="mission">
    <div
      data-theme="dark"
      class="bg-surface-1 grid grid-cols-1 gap-x-16 gap-y-text-m rounded-3xl p-6 md:grid-cols-2 md:px-20 md:py-30"
    >
      <div class="flex flex-col items-start">
        <p class="body-s-strong text-brand-secondary pb-text-s">Mission</p>
        <h2 class="title-l">
          Our mission is to make portable software the default way to build for
          everyone.
        </h2>
      </div>
      <div class="flex flex-col items-start">
        <p class="body-m">
          Our vision is a future where mobile developers operate at the speed of
          web and systems engineers. Where Shorebird is a safe and supported
          choice for businesses and offers a rich and robust Flutter ecosystem.
          We are fundamentally guided by principles like prioritizing developer
          productivity, being open source by default, and believing in the
          inevitability of high-quality portable software. We aim to align our
          success directly with the needs and success of the global Flutter
          developer community.
        </p>
      </div>
    </div>
  </Section>

  {/* "Our team" (Webflow `.c_team--cms`). */}
  <Section theme="light" id="team">
    <div class="grid grid-cols-12 gap-x-column-gap gap-y-row-gap">
      <div class="col-span-12 lg:col-span-3">
        <div class="flex flex-col items-start">
          <h2 class="title-l pb-text-s">Our team</h2>
          <div class="flex items-end gap-2">
            <p class="body-m">Backed by</p>
            <Image
              src={accelLogo}
              alt="Accel"
              width={144}
              class="h-auto w-16 lg:w-[4.5rem]"
            />
          </div>
        </div>
      </div>
      <div class="hidden lg:col-span-1 lg:block"></div>
      <div class="col-span-12 overflow-hidden lg:col-span-8">
        <ul
          class="-mx-6 -my-6 grid w-[calc(100%+3rem)] grid-cols-2 gap-px bg-white md:-mx-16 md:-my-16 md:w-[calc(100%+8rem)] lg:mx-0 lg:w-full"
        >
          {
            team.map((member) => (
              <li class="bg-surface-1 h-full p-6 md:p-16">
                <div class="flex flex-col items-start">
                  <Image
                    src={member.image}
                    alt={member.name}
                    width={400}
                    height={400}
                    class="aspect-square h-auto w-full rounded-2xl object-cover object-top"
                  />
                  <div class="pb-section-xs" />
                  <div class="flex flex-wrap items-center gap-[0.5625rem] pb-text-xs">
                    <p class="body-l text-text-1">{member.name}</p>
                    <a
                      aria-label={member.linkedinLabel}
                      href={member.linkedin}
                      target="_blank"
                      rel="noopener"
                      class="text-text-3 hover:text-text-1 hidden size-4 md:block"
                      set:html={linkedinIcon}
                    />
                  </div>
                  <p class="body-m">{member.role}</p>
                  <div class="md:hidden">
                    <div class="pb-section-xs" />
                    <a
                      aria-label={member.linkedinLabel}
                      href={member.linkedin}
                      target="_blank"
                      rel="noopener"
                      class="text-text-3 hover:text-text-1 block size-4"
                      set:html={linkedinIcon}
                    />
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <Resources />
  <CtaBand />
  <Footer />
</MainLayout>
