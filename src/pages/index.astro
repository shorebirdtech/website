---
import { Navbar } from '@/components/ui/navbar';
import Benefits from '@/components/home/benefits.astro';
import CtaBand from '@/components/ui/cta-band.astro';
import Enterprise from '@/components/home/enterprise.astro';
import FAQ from '@/components/home/faq.astro';
import Footer from '@/components/ui/footer.astro';
import Hero from '@/components/home/hero.astro';
import HowWeHelp from '@/components/home/how-we-help.astro';
import MainLayout from '@/layouts/main.astro';
import Platform from '@/components/home/platform.astro';
import Resources from '@/components/home/resources.astro';
import Security from '@/components/home/security.astro';
import Testimonials from '@/components/home/testimonials.astro';
---

<MainLayout
