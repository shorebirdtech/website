  description="Ship Flutter apps faster with Shorebird Code Push and CI. Deploy fixes instantly, reduce risk, and stay in control of releases."
>
  <Navbar client:load />
  <Hero />
  <Platform />
  <Benefits />
  <Enterprise />
  <Security />
  <HowWeHelp />
  <Testimonials />
  <Resources />
  <FAQ />
  <CtaBand />
  <Footer newsletter />
</MainLayout>
