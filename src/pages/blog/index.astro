---
/**
 * Blog index (Webflow `/blog`): a light hero with the highlighted article on
 * the left, the three most recent posts as a compact list on the right, then
 * the "All articles" grid of every post (newest first — the live page renders
 * all 69 without pagination), then the CTA band + footer.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Navbar } from '@/components/ui/navbar';
import CtaBand from '@/components/ui/cta-band.astro';
import Footer from '@/components/ui/footer.astro';
import MainLayout from '@/layouts/main.astro';
import Section from '@/components/ui/section.astro';

// Newest first; same-day posts tie-break the way the live site orders them.
const posts = (await getCollection('blog')).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() || b.id.localeCompare(a.id),
);

const covers = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/blog/covers/*.{jpeg,jpg,png,gif,webp,avif}',
  { eager: true },
);
const coverFor = (post: (typeof posts)[number]) => {
  const cover = covers[`/src/assets/blog/covers/${post.data.cover}`];
  if (!cover) {
    throw new Error(`Cover image for blog ${post.data.title} not found`);
  }
  return cover.default;
};

// Featured card: the `highlight: true` post (newest wins); fall back to the
// newest post so the slot is never empty.
const highlight = posts.find((post) => post.data.highlight) ?? posts[0];
const latest = posts.filter((post) => post.id !== highlight.id).slice(0, 3);
---

<MainLayout
  title="Shorebird Blog | Insights on Shipping Flutter Apps"
  description="Stay up to date with Flutter development insights, product updates, and best practices for shipping faster with Shorebird."
>
  <Navbar client:load initialTheme="light" />

  <Section as="header" theme="light">
    {/* Webflow `is--section_hero_xl` (10rem / 7.5rem); the live nav overlays
        the page whereas ours is in flow, so subtract its height. */}
    <div class="pb-[calc(var(--spacer-section-hero)-var(--nav-height))]"></div>
    <div class="flex flex-col items-start">
      <h1 class="title-xl pb-text-m">Blog</h1>
      <p class="body-m">Stay up to date with our latest articles</p>
    </div>
    <div class="pb-section-xs"></div>

    <div class="grid grid-cols-12 gap-x-column-gap gap-y-row-gap">
      {/* Highlighted article */}
      <div class="col-span-12 lg:col-span-4">
        <a
          href={`/blog/${highlight.id}`}
          class="group flex flex-col hover:no-underline"
        >
          <div class="overflow-hidden rounded-2xl">
            <Image
              src={coverFor(highlight)}
              widths={[500, 736, 1000]}
              sizes="(max-width: 767px) 100vw, (max-width: 991px) 727px, 390px"
              alt={highlight.data.title}
              class="w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            />
          </div>
          <div class="pb-section-xs"></div>
          <p class="title-s pb-text-s">{highlight.data.title}</p>
          <p class="body-s">{highlight.data.description}</p>
        </a>
      </div>
      <div class="hidden lg:col-span-1 lg:block"></div>

      {/* Latest three: a vertical list on desktop, a horizontal scroller on
          tablet/mobile (Webflow `.c_blog_latest--cms_list`). */}
      <div class="col-span-12 lg:col-span-7">
        <div
          class="latest-list -mx-container flex snap-x snap-mandatory gap-10 overflow-x-auto px-container scroll-px-container lg:mx-0 lg:grid lg:grid-cols-1 lg:overflow-visible lg:px-0"
        >
          {
            latest.map((post) => (
              <a
                href={`/blog/${post.id}`}
                class="group w-[92%] shrink-0 snap-start hover:no-underline md:w-[75%] lg:w-auto"
              >
                <div class="flex flex-col gap-10 lg:grid lg:grid-cols-8 lg:items-center">
                  <div class="lg:col-span-2">
                    <div class="overflow-hidden rounded-2xl">
                      <Image
                        src={coverFor(post)}
                        widths={[500, 736]}
                        sizes="(max-width: 767px) 92vw, (max-width: 991px) 75vw, 150px"
                        alt={post.data.title}
                        class="w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                      />
                    </div>
                  </div>
                  <div class="flex flex-col lg:col-span-6">
                    <p class="title-s pb-text-xs">{post.data.title}</p>
                    <p class="body-s">{post.data.description}</p>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </Section>

  <Section theme="light">
    <p class="body-s pb-text-m">All articles</p>
    <div class="grid grid-cols-1 gap-x-10 gap-y-14 lg:grid-cols-3">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group flex flex-col hover:no-underline"
          >
            <div class="overflow-hidden rounded-2xl">
              <Image
                src={coverFor(post)}
                widths={[500, 736, 1000]}
                sizes="(max-width: 767px) 100vw, (max-width: 991px) 727px, 390px"
                alt={post.data.title}
                loading="lazy"
                class="w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
            <div class="pb-text-l"></div>
            <p class="title-s pb-text-s">{post.data.title}</p>
            <p class="body-s">{post.data.description}</p>
          </a>
        ))
      }
    </div>
  </Section>

  <CtaBand />
  <Footer />
</MainLayout>

<style>
  /* Webflow hides the scrollbar on the tablet/mobile "latest" scroller. */
  .latest-list {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .latest-list::-webkit-scrollbar {
    display: none;
  }
</style>
