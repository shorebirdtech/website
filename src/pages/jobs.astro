---
import config from '@/config';
import { Navbar } from '@/components/ui/navbar';
import Footer from '@/components/ui/footer.astro';
import MainLayout from '@/layouts/main.astro';
import Section from '@/components/ui/section.astro';
---

<MainLayout
  title="Jobs at Shorebird"
  description="Shorebird is a small, fully remote team building the best way to write apps. Built by the people who made Flutter. See our open roles."
>
  <Navbar client:load initialTheme="dark" />
  {/* The live page is just the Gem job board (`config.jobBoardUrl`) in an
      800px iframe under the hero spacer; the board renders its own logo,
      intro copy and "Open positions" list. */}
  <Section as="header" theme="dark" container="none" id="jobs">
    <div class="pb-[calc(var(--spacer-section-hero)-var(--nav-height))]"></div>
    <iframe
      src={config.jobBoardUrl}
      title="Shorebird job board"
      width="100%"
      height="800"
      class="block w-full border-0"
      loading="lazy"></iframe>
  </Section>
  <Footer />
</MainLayout>
