---
/**
 * Success stories index (Webflow `/success-stories`, "Customers Stories"):
 * a dark hero title, the 3-up grid of every story newest first, then the CTA
 * band + footer.
 */
import { Navbar } from '@/components/ui/navbar';
import CtaBand from '@/components/ui/cta-band.astro';
import Footer from '@/components/ui/footer.astro';
import MainLayout from '@/layouts/main.astro';
import Section from '@/components/ui/section.astro';
import StoryCard from '@/components/success-stories/story-card.astro';
import { loadQuery, storiesQuery, type StoryCard as Story } from '@/lib/sanity';

const stories = await loadQuery<Story[]>({
  query: storiesQuery,
  preview: Astro.locals.preview,
});
---

<MainLayout
  title="Customer Stories | Flutter Teams Using Shorebird"
  description="Discover how Flutter teams use Shorebird to ship faster, reduce risk, and deploy with confidence. Read real success stories."
>
  <Navbar client:load initialTheme="dark" />

  <Section as="header" theme="dark">
    {/* Webflow `is--section_hero_xl` (10rem / 7.5rem); the live nav overlays
        the page whereas ours is in flow, so subtract its height. */}
    <div class="pb-[calc(var(--spacer-section-hero)-var(--nav-height))]"></div>
    <div class="flex flex-col items-start">
      <h1 class="title-xl pb-text-m">Customers Stories</h1>
      <p class="body-m">Learn how customers are using Shorebird</p>
    </div>
    <div class="pb-section-xs"></div>
  </Section>

  <Section theme="dark">
    <div class="grid grid-cols-1 gap-x-10 gap-y-14 md:grid-cols-3">
      {stories.map((story) => <StoryCard story={story} />)}
    </div>
  </Section>

  <CtaBand />
  <Footer />
</MainLayout>
