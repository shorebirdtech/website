---
/**
 * Layout for the Markdown pages (`/privacy`, `/terms`, `/dpa`, `/contact`):
 * the live legal pages are a centered `title-xl` hero (optional subtitle),
 * then the rich text in the middle 8 of 12 columns, then the CTA band.
 *
 * Frontmatter: `title` (hero + <title>), `seoTitle?` (overrides <title>),
 * `subtitle?` (e.g. "Last update …"), `description`.
 */
import '@/styles/rich-text.css';
import { Navbar } from '@/components/ui/navbar';
import CtaBand from '@/components/ui/cta-band.astro';
import Footer from '@/components/ui/footer.astro';
import MainLayout from '@/layouts/main.astro';
import Section from '@/components/ui/section.astro';

const { frontmatter } = Astro.props;
const { title, seoTitle, subtitle, description } = frontmatter;
---

<MainLayout title={seoTitle ?? title} description={description}>
  <Navbar client:load initialTheme="dark" />
  <Section as="header" theme="dark">
    <div class="pb-[calc(var(--spacer-section-hero)-var(--nav-height))]"></div>
    <div class="pb-section-s"></div>
    <div class="flex flex-col items-center text-center">
      <h1 class:list={['title-xl', subtitle && 'pb-text-m']}>{title}</h1>
      {subtitle && <p class="body-m">{subtitle}</p>}
    </div>
    <div class="pb-section-xs"></div>
    <div class="pb-section-s"></div>
  </Section>
  <Section theme="dark">
    <div class="grid grid-cols-12 gap-x-column-gap gap-y-row-gap">
      <div class="hidden lg:col-span-2 lg:block"></div>
      <article class="prose rich-text col-span-12 lg:col-span-8">
        <slot />
      </article>
    </div>
  </Section>
  <CtaBand />
  <Footer />
</MainLayout>
