---
/**
 * Success story layout (Webflow success-stories template). Dark page: the
 * publish date, customer name and one-line summary, the cover, then the
 * story rich text in an 8-column main column; a sticky 4-column aside with
 * the "In this story" summary, the industry / company size / website facts
 * and the newsletter card; then the CTA band and footer.
 *
 * The live template has no "highlights" block, so the frontmatter
 * `highlights` field is kept in the schema but not rendered here.
 */
import '@/styles/rich-text.css';
import { Image, getImage } from 'astro:assets';
import { Navbar } from '@/components/ui/navbar';
import CtaBand from '@/components/ui/cta-band.astro';
import Footer from '@/components/ui/footer.astro';
import FormattedDate from '@/components/blog/formatted-date.astro';
import MainLayout from '@/layouts/main.astro';
import NewsletterCard from '@/components/blog/newsletter-card.astro';
import Section from '@/components/ui/section.astro';
import { coverFor, type SuccessStory } from '@/lib/success-stories';

export interface Props {
  story: SuccessStory;
}

const { story } = Astro.props;
const {
  title,
  description,
  date,
  intro = description,
  industry,
  companySize,
  website,
  seoTitle = title,
  seoDescription = description,
} = story.data;

const cover = coverFor(story);
// Open Graph image: the cover, resized so the share card stays small.
const ogImage = await getImage({ src: cover, width: 1200, format: 'jpg' });

const facts = [
  { label: 'Industry', value: industry },
  { label: 'Company size', value: companySize },
].filter((fact) => fact.value);
---

<MainLayout title={seoTitle} description={seoDescription} image={ogImage.src}>
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
  </Fragment>

  <Navbar client:load initialTheme="dark" />

  <Section as="header" theme="dark">
    {/* Webflow `is--section_hero_xl` (10rem / 7.5rem); the live nav overlays
        the page whereas ours is in flow, so subtract its height. */}
    <div class="pb-[calc(var(--spacer-section-hero)-var(--nav-height))]"></div>
    <div class="grid grid-cols-12 gap-x-column-gap gap-y-row-gap">
      <article class="col-span-12 flex flex-col lg:col-span-8">
        <p class="body-s pb-text-m"><FormattedDate date={date} /></p>
        <h1 class="title-l pb-text-m">{title}</h1>
        <p class="body-m">{description}</p>
        {/* Webflow: `is--section_xs` spacer + the cover's own section_xs
            margin-top, then two section_xs spacers before the rich text. */}
        <div class="pb-section-xs"></div>
        <div class="pb-section-xs"></div>
        <Image
          src={cover}
          widths={[500, 800, 1080, 1600]}
          sizes="(max-width: 1023px) 100vw, 820px"
          alt={title}
          class="w-full rounded-3xl object-cover"
        />
        <div class="pb-section-xs"></div>
        <div class="pb-section-xs"></div>
        <div class="prose rich-text">
          <slot />
        </div>
      </article>

      <aside class="col-span-12 pt-section-xs lg:col-span-4 lg:pt-0">
        <div class="lg:sticky lg:top-24">
          <p class="body-s text-text-3 pb-text-m">In this story</p>
          <p class="body-m">{intro}</p>
          <div class="pb-section-xs"></div>
          <div class="divider"></div>
          <div class="pb-section-xs"></div>
          <dl>
            {
              facts.map((fact) => (
                <div class="flex items-end justify-between gap-4 pb-text-s">
                  <dt class="body-m-strong text-text-1">{fact.label}</dt>
                  <dd class="body-m text-right">{fact.value}</dd>
                </div>
              ))
            }
            {
              website && (
                <div class="flex items-end justify-between gap-4">
                  <dt class="body-m-strong text-text-1">Website</dt>
                  <dd class="body-m text-right">
                    <a
                      href={website}
                      target="_blank"
                      rel="noopener"
                      class="font-medium break-all hover:text-text-1"
                    >
                      {website}
                    </a>
                  </dd>
                </div>
              )
            }
          </dl>
          <div class="pb-section-xs"></div>
          <NewsletterCard />
        </div>
      </aside>
    </div>
  </Section>

  <CtaBand />
  <Footer />
</MainLayout>
