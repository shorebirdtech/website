---
/**
 * Click-to-edit overlays for the Studio's Presentation tool. Rendered only
 * when the request carries the preview cookie, and the overlay script is
 * loaded on demand so published pages never ship it.
 */
import { studioUrl } from '@/lib/sanity/config';

interface Props {
  enabled: boolean;
}

const { enabled } = Astro.props;
const exitUrl = `/api/preview/disable?to=${encodeURIComponent(Astro.url.pathname)}`;
---

{
  enabled && (
    <>
      <div data-sanity-visual-editing hidden />
      <div class="preview-pill" role="status">
        <span class="preview-dot" aria-hidden="true" />
        Previewing drafts
        <a href={studioUrl}>Studio</a>
        <a href={exitUrl}>Exit</a>
      </div>
    </>
  )
}

<script>
  import type {
    HistoryAdapter,
    HistoryAdapterNavigate,
  } from '@sanity/visual-editing';

  // This is a multi-page site, so the Studio has to be told the iframe's
  // URL explicitly and every navigation it requests becomes a full load.
  // Mirrors the adapter in @sanity/astro's VisualEditing component.
  const currentUrl = () =>
    `${location.pathname}${location.search}${location.hash}`;

  let navigate: HistoryAdapterNavigate | undefined;
  let lastUrl = '';

  const publish = (url: string, force = false) => {
    if (!navigate || (!force && url === lastUrl)) return;
    lastUrl = url;
    navigate({ type: 'push', title: document.title, url });
  };
  const sync = () => publish(currentUrl());

  // Report same-origin link clicks before the load starts so the Studio's
  // address bar and document list follow along instead of snapping back.
  document.addEventListener(
    'click',
    (event) => {
      if (event.defaultPrevented || event.button !== 0) return;
      if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
      const anchor =
        event.target instanceof Element
          ? event.target.closest<HTMLAnchorElement>('a[href]')
          : null;
      if (!anchor || (anchor.target && anchor.target !== '_self')) return;
      const target = new URL(anchor.href, location.href);
      if (target.origin !== location.origin) return;
      publish(`${target.pathname}${target.search}${target.hash}`, true);
    },
    true,
  );
  window.addEventListener('popstate', sync);
  window.addEventListener('hashchange', sync);

  const history: HistoryAdapter = {
    subscribe(callback) {
      navigate = callback;
      lastUrl = currentUrl();
      navigate({ type: 'replace', title: document.title, url: lastUrl });
      return () => {
        if (navigate === callback) navigate = undefined;
      };
    },
    update(update) {
      if (update.type === 'pop') return window.history.back();
      if (location.href === new URL(update.url, location.href).href) return;
      if (update.type === 'replace') location.replace(update.url);
      else location.assign(update.url);
    },
  };

  if (document.querySelector('[data-sanity-visual-editing]')) {
    const { enableVisualEditing } = await import('@sanity/visual-editing');
    enableVisualEditing({
      zIndex: 1000,
      history,
      // Every edit re-renders on the server; a reload is the simplest way to
      // pick that up without client-side data loaders.
      refresh: () =>
        new Promise<void>((resolve) => {
          location.reload();
          resolve();
        }),
    });
  }
</script>

<style>
  .preview-pill {
    position: fixed;
    bottom: 1rem;
    left: 50%;
    z-index: 999;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--border-1);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text-1);
    font-size: var(--font-size-body-s);
    font-weight: 500;
    transform: translateX(-50%);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.25);
  }
  .preview-pill a {
    color: var(--text-2);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .preview-pill a:hover {
    color: var(--text-1);
  }
  .preview-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--brand-primary);
    box-shadow: 0 0 0 4px
      color-mix(in srgb, var(--brand-primary) 30%, transparent);
  }
</style>
