---
/**
 * "Customers stories — View our customers using Code Push" (Webflow
 * `.c_card--list`): three success-story cards from the content collection.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Section from '@/components/ui/section.astro';

export interface Props {
  eyebrow: string;
  title: string;
  /** Success-story slugs to show, in order. */
  stories: string[];
}

const { eyebrow, title, stories: slugs } = Astro.props;

const covers = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/success-stories/covers/*.{jpeg,jpg,png,gif,webp,avif}',
  { eager: true },
);
const all = await getCollection('successStories');
const stories = slugs.map((slug) => {
  const story = all.find((entry) => entry.id === slug);
  if (!story) throw new Error(`Success story ${slug} not found`);
  const cover = covers[`/src/assets/success-stories/covers/${story.data.cover}`];
  if (!cover) throw new Error(`Cover for success story ${slug} not found`);
  return { ...story, cover: cover.default };
});
---

<Section theme="dark" id="customers">
  <div class="flex flex-col items-start">
    <p class="body-s-strong text-brand-primary pb-text-s">{eyebrow}</p>
    <h2 class="title-l">{title}</h2>
  </div>
  <div class="pb-section-xs"></div>
  <div class="grid grid-cols-1 gap-x-10 gap-y-14 md:grid-cols-3">
    {
      stories.map((story) => (
        <a
          href={`/success-stories/${story.id}`}
          class="group flex flex-col hover:no-underline"
        >
          <div class="pt-text-l" />
          <div class="overflow-hidden rounded-2xl">
            <Image
              src={story.cover}
              widths={[400, 800, 1200]}
              sizes="(max-width: 767px) 100vw, 390px"
              alt={story.data.title}
              class="aspect-[390/220] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            />
          </div>
          <div class="pt-text-s" />
          <p class="title-s pb-text-s">{story.data.title}</p>
          <p class="body-s">{story.data.description}</p>
        </a>
      ))
    }
  </div>
</Section>
