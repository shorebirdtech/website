---
/**
 * Pricing page body: the "Pay as you grow" header with the billing toggle
 * and plan cards (Webflow `header.g_page--section` + `.c_tabs_pricing`),
 * the "Trusted by" logo marquee, then the "Plan comparison" table.
 */
import Brands from '@/components/home/brands.astro';
import Section from '@/components/ui/section.astro';
import { PricingPlans } from '@/components/pricing/pricing-plans';
import { PricingTable } from '@/components/pricing/pricing-table';
---

<Section as="header" theme="dark" container="none" id="plans">
  {/* Webflow `is--section_hero_xl`; the live nav overlays the hero. */}
  <div class="pb-[calc(var(--spacer-section-hero)-var(--nav-height))]"></div>
  <div class="page-container">
    <PricingPlans client:load />
  </div>
  <div class="pb-section-xs"></div>
  <Brands />
  <div class="pb-section-xs"></div>
</Section>

<Section theme="dark" id="plan-comparison">
  <div class="pb-section-s"></div>
  <PricingTable client:load />
</Section>
