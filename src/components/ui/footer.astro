---
/**
 * Site footer (Webflow `.g_page--section.is--footer`).
 *
 * Always dark. Brand column (logo, tagline, social) spans 3/12 columns, the
 * four link columns share the remaining 9/12. On mobile everything stacks and
 * centers. The "Start shipping fast, today!" band above it is a separate page
 * section: include `<CtaBand />` before `<Footer />` where the page needs it.
 */
import { DiscordLogo } from '@/components/logos/discord-logo';
import { GitHubLogo } from '@/components/logos/github-logo';
import { LinkedInLogo } from '@/components/logos/linkedin-logo';
import { LogoFull } from '@/components/logos/logo-full';
import config from '@/config';
import { RssIcon } from '@phosphor-icons/react';

const columns = [
  {
    label: 'Product',
    links: [
      { label: 'Code Push', href: '/product/code-push' },
      { label: 'Shorebird CI', href: '/product/shorebird-ci' },
      { label: 'Pricing', href: '/pricing' },
    ],
  },
  {
    label: 'Resources',
    links: [
      { label: 'Docs', href: config.docsUrl, external: true },
      { label: 'Customers', href: '/success-stories' },
      {
        label: 'FAQ',
        href: `${config.docsUrl}/code-push/faq/`,
        external: true,
      },
      { label: 'Community', href: config.discordUrl, external: true },
    ],
  },
  {
    label: 'Company',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Careers', href: '/jobs' },
      { label: 'Blog', href: '/blog' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  {
    label: 'Legal',
    links: [
      {
        label: 'Trust & Safety',
        href: 'https://trust.shorebird.dev/',
        external: true,
      },
      { label: 'DPA', href: '/dpa' },
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Terms of Service', href: '/terms' },
    ],
  },
];

const social = [
  { label: 'LinkedIn', href: config.linkedInUrl, Icon: LinkedInLogo },
  { label: 'GitHub', href: config.githubUrl, Icon: GitHubLogo },
  { label: 'Discord', href: config.discordUrl, Icon: DiscordLogo },
  { label: 'RSS feed', href: '/rss.xml', Icon: RssIcon },
];
---

<footer
  data-theme="dark"
  data-section
  class="bg-surface-1 border-border pb-section-s border-t pt-3"
>
  <div class="page-container">
    <div class="gap-x-column-gap gap-y-row-gap grid grid-cols-12">
      <div class="col-span-12 lg:col-span-3">
        <div
          class="flex h-full flex-col items-center justify-center lg:items-start lg:justify-between"
        >
          <div class="pb-text-s">
            <a
              href="/"
              aria-label="Shorebird home"
              class="text-text-1 hover:text-text-1 inline-flex"
            >
              <LogoFull className="h-6 w-auto" />
            </a>
          </div>
          <p class="body-s pb-button">Deploy on your schedule</p>
          <ul class="flex items-center gap-4">
            {
              social.map(({ label, href, Icon }) => (
                <li>
                  <a
                    href={href}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={label}
                    class="border-border text-text-3 hover:bg-border hover:text-text-1 flex size-10 items-center justify-center rounded-full border transition-colors duration-300"
                  >
                    <Icon className="size-5" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="col-span-12 lg:col-span-9">
        <div
          class="gap-x-column-gap gap-y-row-gap grid grid-cols-1 lg:grid-cols-4"
        >
          {
            columns.map((column) => (
              <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
                <p class="label-xs pb-text-s">{column.label}</p>
                <ul class="flex flex-col">
                  {column.links.map((link) => (
                    <li class="pb-text-xs">
                      <a
                        href={link.href}
                        target={link.external ? '_blank' : undefined}
                        rel={link.external ? 'noreferrer' : undefined}
                        class="text-button-s text-text-2 hover:text-text-1 font-semibold"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
    <div class="pt-text-xs">
      <p class="body-s text-center lg:text-left">
        Copyright @{new Date().getFullYear()}
      </p>
    </div>
  </div>
</footer>
