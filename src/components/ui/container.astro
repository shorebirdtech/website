---
/**
 * Page container (Webflow `.g_page--container`).
 *
 * `size="small"` → min(100%, 85rem) minus `--container-padding` on each side
 * (1248px wide at 1440px). `size="large"` → 96rem (`.is--large`).
 */
export interface Props {
  size?: 'small' | 'large';
  class?: string;
  [key: string]: unknown;
}
const { size = 'small', class: className, ...rest } = Astro.props;
---

<div
  class:list={[
    size === 'large' ? 'page-container-lg' : 'page-container',
    className,
  ]}
  {...rest}
>
  <slot />
</div>
