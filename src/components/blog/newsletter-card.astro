---
/**
 * "Subscribe to our newsletter" card (Webflow `.c_newsletter`), used in the
 * blog post sidebar.
 */
import NewsletterSignupForm from '@/components/newsletter/newsletter-form';

export interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['bg-surface-2 rounded-2xl p-6 text-center', className]}>
  <p class="title-m pb-text-s">Subscribe to our newsletter</p>
  <p class="body-xs pb-section-xs">
    Stay up to date on product releases <br />and Shorebird events
  </p>
  <NewsletterSignupForm client:load layout="stacked" />
</div>
