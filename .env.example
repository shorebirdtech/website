# Sanity dataset the site reads at build (or per request on the preview server).
SANITY_DATASET=production

# Preview deployment only. Builds the site server-rendered with the
# /api/preview/* routes so the Studio's Presentation tool can show drafts.
PREVIEW_MODE=false

# Preview deployment only, read at runtime: a Sanity token with the Viewer
# role. Never needed for the static build, which reads the public dataset.
SANITY_API_READ_TOKEN=
